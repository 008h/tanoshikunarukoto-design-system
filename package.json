{
  "name": "@008h/design",
  "version": "0.3.0",
  "description": "Shared design tokens and small components for tanoshikunarukoto sites",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/008h/tanoshikunarukoto-design-system.git"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./index.css": "./src/index.css",
    "./tokens.css": "./src/tokens/index.css",
    "./base.css": "./src/base.css",
    "./themes/*.css": "./src/themes/*.css",
    "./tailwind.css": "./src/tailwind/theme.css",
    "./uno": {
      "types": "./dist/uno/preset.d.ts",
      "default": "./dist/uno/preset.js"
    },
    "./sites": {
      "types": "./dist/sites.d.ts",
      "default": "./dist/sites.js"
    },
    "./astro/*": "./src/astro/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "tanoshi-check-colors": "./dist/cli/check-colors.js"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "unocss": ">=66.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "unocss": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check:colors": "tsx src/cli/check-colors.ts --allow-oklch src/tokens/ --allow-oklch src/themes/ --exclude src/cli/",
    "lint:css": "stylelint 'src/**/*.{css,astro}' 'playground/**/*.{css,astro}'",
    "lint:css:fix": "stylelint --fix 'src/**/*.{css,astro}' 'playground/**/*.{css,astro}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gate": "pnpm check:colors && pnpm lint:css && pnpm typecheck && pnpm astro:check && pnpm test && pnpm build && pnpm check:dist && pnpm e2e",
    "playground:dev": "astro dev",
    "playground:build": "astro build",
    "playground:preview": "astro preview",
    "astro:check": "astro check",
    "e2e": "playwright test",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@fontsource/kosugi": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/node": "^4.3.3",
    "@types/node": "^26.0.0",
    "astro": "^7.4.0",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.16.0",
    "stylelint-order": "^8.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vitest": "^4.1.9"
  },
  "private": true
}
